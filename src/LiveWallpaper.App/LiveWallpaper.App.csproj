<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <RootNamespace>LiveWallpaper.App</RootNamespace>
        <AssemblyName>LiveWallpaper</AssemblyName>
        <ApplicationIcon>..\..\assets\LiveWallpaper.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Product>Live Wallpaper</Product>
        <AssemblyTitle>Live Wallpaper</AssemblyTitle>
    </PropertyGroup>
    <ItemGroup>
        <Using Include="System.IO" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="WPF-UI" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\LiveWallpaper.Core\LiveWallpaper.Core.csproj" />
        <ProjectReference Include="..\LiveWallpaper.Windows\LiveWallpaper.Windows.csproj" />
        <ProjectReference Include="..\LiveWallpaper.Media\LiveWallpaper.Media.csproj" />
        <ProjectReference Include="..\LiveWallpaper.Rendering\LiveWallpaper.Rendering.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="..\..\assets\LiveWallpaper.ico" Link="LiveWallpaper.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Resource Include="..\..\assets\LiveWallpaper.ico" Link="Assets\LiveWallpaper.ico" />
    </ItemGroup>
</Project>
