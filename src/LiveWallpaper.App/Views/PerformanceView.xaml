<UserControl
    x:Class="LiveWallpaper.App.Views.PerformanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,0,16">
            <ui:TextBlock FontTypography="Title" Text="Performance" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource HelpText}" Text="Live numbers from the wallpaper engine, updated every second while this page is open." />
            <ui:InfoBar x:Name="EngineWarning" Margin="0,12,0,0" IsClosable="False" Severity="Warning" Title="The wallpaper engine isn't running." />

            <UniformGrid Margin="0,16,0,0" Columns="4">
                <ui:Card Margin="0,0,8,0">
                    <StackPanel><TextBlock Style="{StaticResource HelpText}" Text="Frame rate" /><ui:TextBlock x:Name="Fps" FontTypography="Subtitle" Text="–" /></StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0">
                    <StackPanel><TextBlock Style="{StaticResource HelpText}" Text="Engine memory" /><ui:TextBlock x:Name="Memory" FontTypography="Subtitle" Text="–" /></StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0">
                    <StackPanel><TextBlock Style="{StaticResource HelpText}" Text="Engine CPU" /><ui:TextBlock x:Name="Cpu" FontTypography="Subtitle" Text="–" /></StackPanel>
                </ui:Card>
                <ui:Card>
                    <StackPanel><TextBlock Style="{StaticResource HelpText}" Text="Particles" /><ui:TextBlock x:Name="Particles" FontTypography="Subtitle" Text="–" /></StackPanel>
                </ui:Card>
            </UniformGrid>

            <TextBlock Style="{StaticResource SectionLabel}" Text="Displays" />
            <ItemsControl x:Name="Displays">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource HelpText}" Text="{Binding State}" />
                                <TextBlock Text="{Binding Label}" />
                            </DockPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
