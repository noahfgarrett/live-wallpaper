<UserControl
    x:Class="LiveWallpaper.App.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:preview="clr-namespace:LiveWallpaper.App.Preview"
    xmlns:views="clr-namespace:LiveWallpaper.App.Views"
    xmlns:models="clr-namespace:LiveWallpaper.Core.Models;assembly=LiveWallpaper.Core"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="EffectTabFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" BorderThickness="2" CornerRadius="13" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EffectTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="EffectTabs" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource EffectTabFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Pill"
                            Padding="0,7,0,6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TabDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,-1,-7,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <!-- Not focusable, so Space held for panning never presses the zoom button last clicked. -->
        <Style x:Key="ZoomBarButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
                <ui:Button Click="OnBack" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Back to library" Margin="0,0,12,0" />
                <ui:TextBlock x:Name="Heading" VerticalAlignment="Center" FontTypography="Title" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid x:Name="PreviewArea" Grid.Row="1" SizeChanged="OnPreviewAreaSizeChanged">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border x:Name="PreviewFrame" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <preview:PreviewHost x:Name="Preview" />
                    </Border>
                    <StackPanel x:Name="ZoomBar" Height="32" Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button x:Name="ZoomOutButton" AutomationProperties.Name="Zoom out" Click="OnZoomOut" Icon="{ui:SymbolIcon ZoomOut24}" Style="{StaticResource ZoomBarButton}" ToolTip="Zoom out (Ctrl+−)" />
                        <TextBlock x:Name="ZoomText" MinWidth="48" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" ToolTip="Ctrl+1 for 100 %" />
                        <ui:Button x:Name="ZoomInButton" AutomationProperties.Name="Zoom in" Click="OnZoomIn" Icon="{ui:SymbolIcon ZoomIn24}" Style="{StaticResource ZoomBarButton}" ToolTip="Zoom in (Ctrl+=)" />
                        <ui:Button x:Name="FitButton" Margin="4,0,0,0" Click="OnZoomFit" Content="Fit" Icon="{ui:SymbolIcon ZoomFit24}" Style="{StaticResource ZoomBarButton}" ToolTip="Fit (Ctrl+0)" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,4,16">
                <Border
                    Padding="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="SnowTab" Checked="OnTabChecked" IsChecked="True" Style="{StaticResource EffectTab}" Tag="{x:Static models:EffectKind.Snow}" AutomationProperties.Name="Snow">
                            <StackPanel>
                                <Grid HorizontalAlignment="Center">
                                    <ui:SymbolIcon FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Symbol="WeatherSnow24" />
                                    <Ellipse x:Name="SnowDot" Style="{StaticResource TabDot}" />
                                </Grid>
                                <TextBlock Style="{StaticResource TabLabel}" Text="Snow" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RainTab" Checked="OnTabChecked" Style="{StaticResource EffectTab}" Tag="{x:Static models:EffectKind.Rain}" AutomationProperties.Name="Rain">
                            <StackPanel>
                                <Grid HorizontalAlignment="Center">
                                    <ui:SymbolIcon FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Symbol="WeatherRain24" />
                                    <Ellipse x:Name="RainDot" Style="{StaticResource TabDot}" />
                                </Grid>
                                <TextBlock Style="{StaticResource TabLabel}" Text="Rain" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="GlassTab" Checked="OnTabChecked" Style="{StaticResource EffectTab}" Tag="{x:Static models:EffectKind.Glass}" AutomationProperties.Name="Glass">
                            <StackPanel>
                                <Grid HorizontalAlignment="Center">
                                    <ui:SymbolIcon FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Symbol="Window24" />
                                    <Ellipse x:Name="GlassDot" Style="{StaticResource TabDot}" />
                                </Grid>
                                <TextBlock Style="{StaticResource TabLabel}" Text="Glass" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="WaterTab" Checked="OnTabChecked" Style="{StaticResource EffectTab}" Tag="{x:Static models:EffectKind.Water}" AutomationProperties.Name="Water">
                            <StackPanel>
                                <Grid HorizontalAlignment="Center">
                                    <ui:SymbolIcon FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Symbol="Drop24" />
                                    <Ellipse x:Name="WaterDot" Style="{StaticResource TabDot}" />
                                </Grid>
                                <TextBlock Style="{StaticResource TabLabel}" Text="Water" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <StackPanel x:Name="SnowPanel" Margin="0,20,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <ui:ToggleSwitch x:Name="SnowEnabled" DockPanel.Dock="Right" Checked="OnSnowChanged" Unchecked="OnSnowChanged" />
                        <ui:TextBlock VerticalAlignment="Center" FontTypography="Subtitle" Text="Snow" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HelpText}" Text="Changes show in the preview right away, and on your desktop too if this image is applied." />
                    <DockPanel Margin="0,20,0,4"><TextBlock x:Name="SnowDensityValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Density" /></DockPanel>
                    <Slider x:Name="SnowDensity" Maximum="100" Minimum="0" ValueChanged="OnSnowSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="SnowSpeedValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Speed" /></DockPanel>
                    <Slider x:Name="SnowSpeed" Maximum="100" Minimum="0" ValueChanged="OnSnowSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="SnowWindValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Wind" /></DockPanel>
                    <Slider x:Name="SnowWind" Maximum="100" Minimum="0" ValueChanged="OnSnowSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="SnowSizeValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Flake size" /></DockPanel>
                    <Slider x:Name="SnowFlakeSize" Maximum="100" Minimum="0" ValueChanged="OnSnowSliderChanged" />
                    <DockPanel Margin="0,20,0,0">
                        <ui:ToggleSwitch x:Name="MotionBlur" DockPanel.Dock="Right" Checked="OnSnowChanged" Unchecked="OnSnowChanged" />
                        <TextBlock VerticalAlignment="Center" Text="Motion blur" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="RainPanel" Margin="0,20,0,0" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,4">
                        <ui:ToggleSwitch x:Name="RainEnabled" DockPanel.Dock="Right" Checked="OnRainChanged" Unchecked="OnRainChanged" />
                        <ui:TextBlock VerticalAlignment="Center" FontTypography="Subtitle" Text="Rain" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HelpText}" Text="Changes show in the preview right away, and on your desktop too if this image is applied." />
                    <DockPanel Margin="0,20,0,4"><TextBlock x:Name="RainDensityValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Density" /></DockPanel>
                    <Slider x:Name="RainDensity" Maximum="100" Minimum="0" ValueChanged="OnRainSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="RainSpeedValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Speed" /></DockPanel>
                    <Slider x:Name="RainSpeed" Maximum="100" Minimum="0" ValueChanged="OnRainSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="RainWindValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Wind" /></DockPanel>
                    <Slider x:Name="RainWind" Maximum="100" Minimum="0" ValueChanged="OnRainSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="RainLengthValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Streak length" /></DockPanel>
                    <Slider x:Name="RainLength" Maximum="100" Minimum="0" ValueChanged="OnRainSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="RainBrightnessValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Brightness" /></DockPanel>
                    <Slider x:Name="RainBrightness" Maximum="100" Minimum="0" ValueChanged="OnRainSliderChanged" />
                </StackPanel>

                <StackPanel x:Name="GlassPanel" Margin="0,20,0,0" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,4">
                        <ui:ToggleSwitch x:Name="GlassEnabled" DockPanel.Dock="Right" Checked="OnGlassChanged" Unchecked="OnGlassChanged" />
                        <ui:TextBlock VerticalAlignment="Center" FontTypography="Subtitle" Text="Glass" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HelpText}" Text="Changes show in the preview right away, and on your desktop too if this image is applied." />
                    <DockPanel Margin="0,20,0,4"><TextBlock x:Name="GlassDropsValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Drops" /></DockPanel>
                    <Slider x:Name="GlassDrops" Maximum="100" Minimum="0" ValueChanged="OnGlassSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="GlassDropSizeValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Drop size" /></DockPanel>
                    <Slider x:Name="GlassDropSize" Maximum="100" Minimum="0" ValueChanged="OnGlassSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="GlassSlidingValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Sliding" /></DockPanel>
                    <Slider x:Name="GlassSliding" Maximum="100" Minimum="0" ValueChanged="OnGlassSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="GlassFogValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Fog" /></DockPanel>
                    <Slider x:Name="GlassFog" Maximum="100" Minimum="0" ValueChanged="OnGlassSliderChanged" />
                </StackPanel>

                <StackPanel x:Name="WaterPanel" Margin="0,20,0,0" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,4">
                        <ui:ToggleSwitch x:Name="WaterEnabled" DockPanel.Dock="Right" Checked="OnWaterChanged" Unchecked="OnWaterChanged" />
                        <ui:TextBlock VerticalAlignment="Center" FontTypography="Subtitle" Text="Water" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource HelpText}" Text="Changes show in the preview right away, and on your desktop too if this image is applied." />
                    <DockPanel Margin="0,20,0,4"><TextBlock x:Name="WaterStretchValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Stretch" /></DockPanel>
                    <Slider x:Name="WaterStretch" Maximum="100" Minimum="0" ValueChanged="OnWaterSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="WaterFoamValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Foam" /></DockPanel>
                    <Slider x:Name="WaterFoam" Maximum="100" Minimum="0" ValueChanged="OnWaterSliderChanged" />
                    <DockPanel Margin="0,16,0,4"><TextBlock x:Name="WaterMistValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Mist" /></DockPanel>
                    <Slider x:Name="WaterMist" Maximum="100" Minimum="0" ValueChanged="OnWaterSliderChanged" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Regions" />
                <TextBlock x:Name="RegionsHelp" Style="{StaticResource HelpText}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="AddRegionButton" Grid.Column="0" HorizontalAlignment="Stretch" Appearance="Primary" Click="OnAddRegion" Icon="{ui:SymbolIcon Add24}" />
                    <ui:Button x:Name="DeleteRegionButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnDeleteRegion" Icon="{ui:SymbolIcon Delete24}" IsEnabled="False" />
                </Grid>
                <DockPanel x:Name="InvertRow" Margin="0,16,0,0">
                    <ui:ToggleSwitch x:Name="InvertRegions" DockPanel.Dock="Right" Checked="OnInvertChanged" Unchecked="OnInvertChanged" />
                    <TextBlock x:Name="InvertLabel" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,16,0,4"><TextBlock x:Name="FeatherValue" DockPanel.Dock="Right" Style="{StaticResource HelpText}" /><TextBlock Text="Soft edge" /></DockPanel>
                <Slider x:Name="Feather" IsSnapToTickEnabled="True" LargeChange="1" Maximum="10" Minimum="0" SmallChange="0.1" TickFrequency="0.1" ValueChanged="OnFeatherChanged" />
                <DockPanel Margin="0,16,0,0">
                    <ui:ToggleSwitch x:Name="ShowOutlines" DockPanel.Dock="Right" IsChecked="True" Checked="OnOutlinesChanged" Unchecked="OnOutlinesChanged" />
                    <TextBlock VerticalAlignment="Center" Text="Show outlines" />
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="UndoButton" Grid.Column="0" HorizontalAlignment="Stretch" Click="OnUndo" Content="Undo" Icon="{ui:SymbolIcon ArrowUndo24}" IsEnabled="False" ToolTip="Undo (Ctrl+Z)" />
                    <ui:Button x:Name="RedoButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnRedo" Content="Redo" Icon="{ui:SymbolIcon ArrowRedo24}" IsEnabled="False" ToolTip="Redo (Ctrl+Y)" />
                </Grid>
                <TextBlock x:Name="CornerHelp" Margin="0,8,0,0" Style="{StaticResource HelpText}" Text="Click an edge to add a corner. Right-click a corner, or select it and press Delete, to remove it." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Scaling" />
                <ComboBox x:Name="ScalingChoice" SelectionChanged="OnScalingChanged">
                    <ComboBoxItem Content="Fill" Tag="Fill" />
                    <ComboBoxItem Content="Fit" Tag="Fit" />
                    <ComboBoxItem Content="Stretch" Tag="Stretch" />
                    <ComboBoxItem Content="Center" Tag="Center" />
                </ComboBox>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource HelpText}" Text="Used for the preview, and as the starting choice when you apply." />

                <ui:Button Margin="0,24,0,0" HorizontalAlignment="Stretch" Appearance="Primary" Click="OnApply" Content="Apply to desktop" Icon="{ui:SymbolIcon Desktop24}" />
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" Style="{StaticResource HelpText}" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
            <views:ApplyPanel x:Name="ApplyPanel" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
