<UserControl
    x:Class="LiveWallpaper.App.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:LiveWallpaper.App.Views"
    AllowDrop="True"
    Background="Transparent"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,4,0,16">
            <ui:Button
                DockPanel.Dock="Right"
                Appearance="Primary"
                Click="OnImport"
                Content="Import images"
                Icon="{ui:SymbolIcon Add24}" />
            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="Library" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource HelpText}" Text="Import a photo, add snow in the editor, then apply it to your desktop." />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <DockPanel x:Name="EngineWarning" Margin="0,0,0,12" Visibility="Collapsed">
                <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnStartEngine" Content="Start" />
                <ui:InfoBar IsClosable="False" IsOpen="True" Severity="Warning" Title="The wallpaper engine isn't running." Message="Start it to apply wallpapers to your desktop." />
            </DockPanel>
            <ui:InfoBar x:Name="ProblemBar" Margin="0,0,0,12" IsClosable="False" Severity="Error" Title="There's a problem showing your wallpaper" />
            <ui:InfoBar x:Name="MessageBar" Margin="0,0,0,12" IsClosable="True" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:LibraryCard}">
                        <Border
                            Width="264"
                            Margin="0,0,14,14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <Border Height="148" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#0D1422">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Margin="14,12,14,14">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Border Margin="0,0,6,0" Padding="8,2" CornerRadius="9" Background="#2A3B55" Visibility="{Binding SnowBadge}">
                                            <TextBlock FontSize="11" Foreground="{StaticResource IceBrush}" Text="Snow" />
                                        </Border>
                                        <Border Padding="8,2" CornerRadius="9" Background="#24402A" Visibility="{Binding DesktopBadge}">
                                            <TextBlock FontSize="11" Foreground="#9BE08F" Text="On desktop" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                        <ui:Button Appearance="Primary" Click="OnApplyCard" Content="Apply" Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,6,0" />
                                        <ui:Button Click="OnEditCard" Content="Edit" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,6,0" />
                                        <ui:Button Click="OnRemoveCard" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove from library" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="Image24" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontTypography="Subtitle" Text="Your library is empty" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource HelpText}" Text="Import a photo, or drop one here, to get started." />
            <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Appearance="Primary" Click="OnImport" Content="Import images" Icon="{ui:SymbolIcon Add24}" />
        </StackPanel>

        <Grid x:Name="Overlay" Grid.RowSpan="3" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
            <views:ApplyPanel x:Name="ApplyPanel" Visibility="Collapsed" />
            <Border
                x:Name="RemoveConfirm"
                Width="420"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <StackPanel>
                    <ui:TextBlock x:Name="RemoveTitle" FontTypography="Subtitle" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource HelpText}" Text="The original file isn't deleted. If it's on your desktop, that display goes back to your normal wallpaper." />
                    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Click="OnCancelRemove" Content="Cancel" />
                        <ui:Button Appearance="Danger" Click="OnConfirmRemove" Content="Remove" Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
