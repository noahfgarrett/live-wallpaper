<ui:FluentWindow
    x:Class="LiveWallpaper.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Live Wallpaper"
    Width="1100"
    Height="720"
    MinWidth="860"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/LiveWallpaper.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Live Wallpaper" ShowHelp="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="12,4,8,16">
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#8A8A8A" />
                        <TextBlock x:Name="EngineText" Style="{StaticResource HelpText}" Text="Connecting to the engine…" />
                    </StackPanel>
                </StackPanel>
                <ListBox
                    x:Name="Navigation"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="OnNavigate">
                    <ListBoxItem x:Name="NavLibrary" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ImageMultiple24" Margin="0,0,12,0" />
                            <TextBlock Text="Library" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavSettings" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavPerformance" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataUsage24" Margin="0,0,12,0" />
                            <TextBlock Text="Performance" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="8,0,20,16" />
        </Grid>
    </Grid>
</ui:FluentWindow>
