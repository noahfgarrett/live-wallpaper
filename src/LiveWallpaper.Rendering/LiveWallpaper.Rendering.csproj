<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>LiveWallpaper.Rendering</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Vortice.Direct3D11" />
        <PackageReference Include="Vortice.DXGI" />
        <PackageReference Include="Vortice.D3DCompiler" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\LiveWallpaper.Media\LiveWallpaper.Media.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="LiveWallpaper.Rendering.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
